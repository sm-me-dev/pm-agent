PM_AGENT_MODEL=glm-5.2
PM_AGENT_BASE_URL=http://localhost:11434/v1
PM_AGENT_API_KEY=
# PM_AGENT_DB_PATH is typically per-project via .pm-agent/state.db
# Set here only to override per-project default:
# PM_AGENT_DB_PATH=~/.local/share/pm-agent/state.db
PM_AGENT_HISTORY_LIMIT=75
PM_AGENT_CONTEXT_TOKEN_BUDGET=6000
PM_AGENT_STRUCTURED_OUTPUT_MODE=auto
PM_AGENT_BRANCH=unknown
